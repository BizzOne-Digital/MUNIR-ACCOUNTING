# Contact form email delivery (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=munirnadeem@live.com
# Sender address on a domain verified in Resend, e.g. "Website Enquiries <enquiries@yourdomain.ca>".
CONTACT_FROM_EMAIL=

# Public site URL once the domain is live (used for canonical URLs and Open Graph). Example: https://www.example.ca
NEXT_PUBLIC_SITE_URL=
